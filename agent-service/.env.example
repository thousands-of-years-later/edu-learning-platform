# Agent 服务环境变量示例（复制为 .env 后填真实值，.env 不进 git）

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# 生产必须使用只读账号，且只授 v_agent_* 视图 SELECT
DB_READONLY_URL=mysql+pymysql://edu_ro:CHANGE_ME@127.0.0.1:3306/learning_platform?charset=utf8mb4

# Java 调 Python 的内部鉴权，Java 与 Python 必须一致
AGENT_INTERNAL_TOKEN=CHANGE_ME

AGENT_PORT=8100
