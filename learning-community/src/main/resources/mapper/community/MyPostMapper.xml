<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.community.mapper.MyPostMapper">

	<resultMap type="PostSummary" id="PostSummaryResult">
		<id     property="postId"        column="post_id"        />
		<result property="postTitle"     column="post_title"     />
		<result property="likeCount"     column="like_count"     />
		<result property="favoriteCount" column="favorite_count" />
	</resultMap>

	<!-- 社区 / 分类列表项：比「我的文章」多作者（昵称/头像）、阅读数、评论数 -->
	<resultMap type="PostListSummary" id="PostListSummaryResult">
		<id     property="postId"        column="post_id"        />
		<result property="postTitle"     column="post_title"     />
		<result property="userName"      column="user_name"      />
		<result property="avatar"        column="avatar"         />
		<result property="viewCount"     column="view_count"     />
		<result property="likeCount"     column="like_count"     />
		<result property="favoriteCount" column="favorite_count" />
		<result property="commentCount"  column="comment_count"  />
	</resultMap>

	<resultMap type="PostDetail" id="PostDetailResult">
		<id     property="postId"       column="post_id"       />
		<result property="postTitle"    column="post_title"    />
		<result property="content"      column="content"       />
		<result property="userId"       column="user_id"       />
		<result property="userName"     column="user_name"     />
		<result property="avatar"       column="avatar"        />
		<result property="categoryName" column="category_name" />
		<result property="createTime"   column="create_time"   />
		<result property="likeCount"    column="like_count"    />
		<result property="commentCount" column="comment_count" />
	</resultMap>

	<!--
	  我的文章列表：只查设计稿上要显示的四列（标题、点赞、收藏、主键）。
	  不查 content（longtext，列表用不到）、不查状态/分类/作者（列表不显示）。
	-->
	<select id="selectMyPublishedList" resultMap="PostSummaryResult">
		select p.post_id, p.post_title, p.like_count, p.favorite_count
		  from learning_post p
		 where p.user_id = #{userId} and p.del_flag = '0' and p.status = '0'
		 order by p.create_time desc, p.post_id desc
	</select>

	<!--
	  已发布文章列表（社区首页 / 分类页）：
	  标题 + 作者（昵称/头像）+ 阅读数 + 评论数 + 点赞数 + 收藏数。
	  只认已发布：草稿/待审核/已下架/已驳回/已删除一律不出现。
	  categoryId 为空 = 全部分类（社区信息流）。

	  作者资料、评论数用标量子查询，不 join：
	    - 避免 PageHelper 追加排序时撞 sys_user / learning_comment 的同名列（1052）；
	    - 与详情 selectPublishedById 的写法一致。
	  评论数取 learning_comment 的 count(*)：平台约定接口返回的评论数以 count(*) 为准，
	  learning_post.comment_count 只供后台列表展示（见 sql/learning_comment.sql）。
	  头像用 nullif(trim(...)) 把老数据的空串归一成 null（与用户资料接口一致）。
	  view_count 由 sql/learning_post_view_count.sql 新增，首次阅读时 +1。
	  create_time 相同时用 post_id 兜底，保证分页翻页不重不漏。
	-->
	<select id="selectPublishedList" resultMap="PostListSummaryResult">
		select p.post_id, p.post_title,
		       (select u.user_name from sys_user u where u.user_id = p.user_id) as user_name,
		       (select nullif(trim(u.avatar), '') from sys_user u where u.user_id = p.user_id) as avatar,
		       ifnull(p.view_count, 0) as view_count,
		       p.like_count, p.favorite_count,
		       (select count(*) from learning_comment c
		         where c.target_type = '1' and c.target_id = p.post_id and c.del_flag = '0') as comment_count
		  from learning_post p
		 where p.del_flag = '0' and p.status = '0'
		<if test="categoryId != null">
		   and p.category_id = #{categoryId}
		</if>
		 order by p.create_time desc, p.post_id desc
	</select>

	<!--
	  文章详情：标题 + 正文 + 作者（昵称/头像）+ 分类标签 + 时间 + 点赞数 + 评论数。
	  作者昵称/头像、分类名用标量子查询取，不 join（避免客户端排序字段撞同名列 1052）。
	  只认已发布：草稿/待审核/已下架/已删除一律查不到。
	-->
	<select id="selectPublishedById" resultMap="PostDetailResult">
		select p.post_id, p.post_title, p.content, p.user_id,
		       (select u.user_name from sys_user u where u.user_id = p.user_id) as user_name,
		       (select u.avatar    from sys_user u where u.user_id = p.user_id) as avatar,
		       (select c.category_name from learning_category c where c.category_id = p.category_id) as category_name,
		       p.create_time, p.like_count, p.comment_count
		  from learning_post p
		 where p.post_id = #{postId} and p.del_flag = '0' and p.status = '0'
	</select>

</mapper>
