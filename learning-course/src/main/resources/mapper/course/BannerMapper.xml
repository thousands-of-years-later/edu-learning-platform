<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.course.mapper.BannerMapper">

	<resultMap type="Banner" id="BannerResult">
		<id     property="bannerId"     column="banner_id"     />
		<result property="categoryId"   column="category_id"   />
		<result property="categoryName" column="category_name" />
		<result property="title"        column="title"         />
		<result property="imageUrl"     column="image_url"     />
		<result property="courseId"     column="course_id"     />
		<result property="courseName"   column="course_name"   />
		<result property="orderNum"     column="order_num"     />
		<result property="status"       column="status"        />
		<result property="delFlag"      column="del_flag"      />
		<result property="createBy"     column="create_by"     />
		<result property="createTime"   column="create_time"   />
		<result property="updateBy"     column="update_by"     />
		<result property="updateTime"   column="update_time"   />
		<result property="remark"       column="remark"        />
	</resultMap>

	<!--
	  列表查询【不 join learning_category / learning_course】，展示名一律用标量子查询。
	  原因（与 ShortVideoMapper.xml 一致，比 CourseMapper 的 left join 更稳）：
	  learning_banner / learning_category / learning_course 三张表都有
	  status / create_time / order_num / remark 等同名列，一旦 join，
	  bootstrap-table 点列头排序（sortName -> PageHelper 追加【不带前缀】的 order by <列名>）
	  立刻报 1052 Column ... in order clause is ambiguous；单表 FROM 则任何列都不会歧义。

	  两个子查询【故意不带 del_flag 过滤】：后台必须还能看到目标已删/已停用的名字，
	  否则运营看到一片空白也不知道原来挂的是哪条数据。可见性只在 selectVisibleBanners 里收紧。
	-->
	<sql id="selectBannerVo">
        select b.banner_id, b.category_id, b.title, b.image_url, b.course_id, b.order_num,
               b.status, b.del_flag,
               b.create_by, b.create_time, b.update_by, b.update_time, b.remark,
               (select cat.category_name from learning_category cat where cat.category_id = b.category_id) as category_name,
               (select c.course_name from learning_course c where c.course_id = b.course_id) as course_name
          from learning_banner b
    </sql>

	<select id="selectBannerList" parameterType="Banner" resultMap="BannerResult">
	    <include refid="selectBannerVo"/>
		<where>
			b.del_flag = '0'
			<!-- 只判 null，不判空串：categoryId 是 Long，0 是有效筛选值（只看「全部」窗口），
			     而「所有类别」由前端不传该参数（或传空串被 Spring 绑成 null）表达。 -->
			<if test="categoryId != null">
				AND b.category_id = #{categoryId}
			</if>
			<if test="title != null and title != ''">
				AND b.title like concat('%', #{title}, '%')
			</if>
			<if test="status != null and status != ''">
				AND b.status = #{status}
			</if>
		</where>
		order by b.order_num asc, b.banner_id asc
	</select>

	<select id="selectBannerById" parameterType="Long" resultMap="BannerResult">
		<include refid="selectBannerVo"/>
		where b.banner_id = #{bannerId} and b.del_flag = '0'
	</select>

	<!--
	  App 端可见性：轮播自身正常 + 目标课程可见。
	  exists 而非 join：既不影响上面「单表 FROM」的抗歧义约定，也顺带覆盖了
	  「课程被停用/软删后，轮播不该再出现」这条规则 —— 课程停用是可逆的，
	  读时过滤比在删课程时级联删轮播安全（后者在课程恢复时无从还原）。
	  这是【静默隐藏】：后台列表照旧显示为「正常」，只有 App 看不到。
	-->
	<select id="selectVisibleBanners" parameterType="Long" resultMap="BannerResult">
		<include refid="selectBannerVo"/>
		where b.del_flag = '0' and b.status = '0' and b.category_id = #{categoryId}
		  and exists (select 1 from learning_course vc
		               where vc.course_id = b.course_id and vc.del_flag = '0' and vc.status = '0')
		order by b.order_num asc, b.banner_id asc
	</select>

	<insert id="insertBanner" parameterType="Banner" useGeneratedKeys="true" keyProperty="bannerId">
 		insert into learning_banner(
 			<if test="categoryId != null">category_id,</if>
 			<if test="title != null and title != ''">title,</if>
 			<if test="imageUrl != null and imageUrl != ''">image_url,</if>
 			<if test="courseId != null">course_id,</if>
 			<if test="orderNum != null">order_num,</if>
 			<if test="status != null and status != ''">status,</if>
 			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
 			<if test="categoryId != null">#{categoryId},</if>
 			<if test="title != null and title != ''">#{title},</if>
 			<if test="imageUrl != null and imageUrl != ''">#{imageUrl},</if>
 			<if test="courseId != null">#{courseId},</if>
 			<if test="orderNum != null">#{orderNum},</if>
 			<if test="status != null and status != ''">#{status},</if>
 			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
 		)
	</insert>

	<update id="updateBanner" parameterType="Banner">
 		update learning_banner
 		<set>
 			<!-- category_id / course_id 不加 <if>：编辑页始终提交这两个字段
 			     （「不选类别」就是类别 0=全部），包了 <if> 反而会让显式选择被静默忽略。
 			     与 CourseMapper.updateCourse 的处理一致。 -->
 			category_id = #{categoryId,jdbcType=BIGINT},
 			course_id = #{courseId,jdbcType=BIGINT},
 			<if test="title != null and title != ''">title = #{title},</if>
 			<if test="imageUrl != null">image_url = #{imageUrl},</if>
 			<if test="orderNum != null">order_num = #{orderNum},</if>
 			<if test="status != null and status != ''">status = #{status},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where banner_id = #{bannerId} and del_flag = '0'
	</update>

	<!-- where 带 del_flag = '0'：重复执行不会反复改写已删行的 update_time -->
	<update id="deleteBannerByIds" parameterType="Long">
		update learning_banner set del_flag = '2', update_time = sysdate() where banner_id in
		<foreach collection="array" item="bannerId" open="(" separator="," close=")">
 			#{bannerId}
        </foreach>
        and del_flag = '0'
	</update>

</mapper>
