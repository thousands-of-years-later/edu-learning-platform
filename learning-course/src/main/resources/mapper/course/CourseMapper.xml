<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.course.mapper.CourseMapper">

	<resultMap type="Course" id="CourseResult">
		<id     property="courseId"      column="course_id"      />
		<result property="courseName"    column="course_name"    />
		<result property="categoryId"    column="category_id"    />
		<result property="coverUrl"      column="cover_url"      />
		<result property="intro"         column="intro"          />
		<result property="likeCount"     column="like_count"     />
		<result property="favoriteCount" column="favorite_count" />
		<result property="commentCount"  column="comment_count"  />
		<result property="ratingCount"   column="rating_count"   />
		<result property="ratingScore"   column="rating_score"   />
		<result property="status"        column="status"         />
		<result property="delFlag"       column="del_flag"       />
		<result property="categoryName"  column="category_name"  />
		<result property="createBy"      column="create_by"      />
		<result property="createTime"    column="create_time"    />
		<result property="updateBy"      column="update_by"      />
		<result property="updateTime"    column="update_time"    />
		<result property="remark"        column="remark"         />
	</resultMap>

	<!-- 类别名称为逻辑外键关联查询，类别被删除时不影响课程本身的读取 -->
	<sql id="selectCourseVo">
		select c.course_id, c.course_name, c.category_id, c.cover_url, c.intro,
		       c.like_count, c.favorite_count, c.comment_count, c.rating_count, c.rating_score,
		       c.status, c.del_flag,
		       c.create_by, c.create_time, c.update_by, c.update_time, c.remark,
		       cat.category_name
		  from learning_course c
		  left join learning_category cat on cat.category_id = c.category_id and cat.del_flag = '0'
	</sql>

	<select id="selectCourseList" parameterType="Course" resultMap="CourseResult">
	    <include refid="selectCourseVo"/>
		<where>
			c.del_flag = '0'
			<if test="courseName != null and courseName != ''">
				AND c.course_name like concat('%', #{courseName}, '%')
			</if>
			<if test="categoryId != null">
				AND c.category_id = #{categoryId}
			</if>
			<if test="status != null and status != ''">
				AND c.status = #{status}
			</if>
		</where>
		<!--
		  列表排序（App 接口传 sortBy）：只走白名单 <choose>，绝不 ${} 拼接。
		  sortBy 为空（后台列表、导出、老的调用）时整段不输出，SQL 与加排序前完全一致；
		  后台点列头排序走的是 PageHelper 的 orderByColumn 机制（它会替换掉 SQL 里的 order by），
		  两者互不干扰。
		  上面已 join learning_category，两表都有 create_time / status / remark，
		  排序列一律带 c. 前缀，否则 MySQL 报 1052 Column ... in order clause is ambiguous。
		  每个分支都补 course_id 兜底：create_time 只精确到秒、点赞数并列常见，
		  少了第二排序键翻页会重复或漏行（与 CommentMapper / ShortVideoMapper 同一思路）。
		-->
		<if test="sortBy != null and sortBy != ''">
			order by
			<choose>
				<when test="sortBy == 'likeCount'">c.like_count desc, c.course_id desc</when>
				<when test="sortBy == 'avgScore'">
					<!-- 综合评分 = rating_score / rating_count（MySQL 的 / 是精确除法，不是整除）；
					     无人评分（rating_count 为 0 或 null）按 0 算，排最后；
					     同分时评分人数多的在前，再同则新课程在前 -->
					case when c.rating_count > 0 then c.rating_score / c.rating_count else 0 end desc,
					c.rating_count desc,
					c.course_id desc
				</when>
				<otherwise>c.create_time desc, c.course_id desc</otherwise>
			</choose>
		</if>
	</select>

	<select id="selectCourseById" parameterType="Long" resultMap="CourseResult">
		<include refid="selectCourseVo"/>
		where c.course_id = #{courseId} and c.del_flag = '0'
	</select>

	<select id="checkCourseNameUnique" parameterType="Course" resultMap="CourseResult">
		<include refid="selectCourseVo"/>
		where c.course_name = #{courseName} and c.del_flag = '0' limit 1
	</select>

	<insert id="insertCourse" parameterType="Course" useGeneratedKeys="true" keyProperty="courseId">
 		insert into learning_course(
 			<if test="courseName != null and courseName != ''">course_name,</if>
 			<if test="categoryId != null">category_id,</if>
 			<if test="coverUrl != null and coverUrl != ''">cover_url,</if>
 			<if test="intro != null and intro != ''">intro,</if>
 			<if test="status != null and status != ''">status,</if>
 			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
 			<if test="courseName != null and courseName != ''">#{courseName},</if>
 			<if test="categoryId != null">#{categoryId},</if>
 			<if test="coverUrl != null and coverUrl != ''">#{coverUrl},</if>
 			<if test="intro != null and intro != ''">#{intro},</if>
 			<if test="status != null and status != ''">#{status},</if>
 			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
 		)
	</insert>

	<update id="updateCourse" parameterType="Course">
 		update learning_course
 		<set>
 			<if test="courseName != null and courseName != ''">course_name = #{courseName},</if>
 			<!-- category_id 不加 <if>：编辑页始终提交该字段，「不选类别」就是把它置空。
 			     包了 <if> 的话选了空类别也清不掉原来的绑定。 -->
 			category_id = #{categoryId,jdbcType=BIGINT},
 			<if test="coverUrl != null">cover_url = #{coverUrl},</if>
 			<if test="intro != null">intro = #{intro},</if>
 			<if test="status != null and status != ''">status = #{status},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where course_id = #{courseId} and del_flag = '0'
	</update>

	<!--
	  逻辑删除课程，并在同一句里清零计数列。
	  like_count / favorite_count / comment_count 由 learning-interation 维护（点赞收藏 / 评论），
	  rating_count / rating_score 由评分模块维护（见 learning_course_rating.sql），
	  内容一删它们的真实值就是 0，留着旧值会让 *_fix_count.sql 的对账把「内容已不存在」的行也算成不一致。
	  评分的两列在这里一起清零的原因：服务层已在同一事务里把该课程的评分行硬删除
	  （CourseRatingMapper.deleteRatingByCourseIds），删完还留旧统计必然对不上。
	-->
	<update id="deleteCourseByIds" parameterType="Long">
		update learning_course
		   set del_flag = '2', like_count = 0, favorite_count = 0, comment_count = 0,
		       rating_count = 0, rating_score = 0, update_time = sysdate()
		 where course_id in
		<foreach collection="array" item="courseId" open="(" separator="," close=")">
 			#{courseId}
        </foreach>
        and del_flag = '0'
	</update>

	<select id="countCourseByCategoryId" parameterType="Long" resultType="int">
		select count(1) from learning_course where category_id = #{categoryId} and del_flag = '0'
	</select>

	<!--
	  级联清理：挂在被删课程上的点赞收藏（learning_interaction）与评论（learning_comment）。
	  两张表都在 learning-interation 模块，本模块只依赖 ruoyi-common，反向注入会形成循环依赖，
	  所以按 CategoryMapper.countPostByCategoryId 的先例直接写纯 SQL。
	  learning_interaction 没有 del_flag（取消点赞本就是硬删除），这里同样是硬删除；
	  learning_comment 与内容表一致走软删除。
	  target_type 必须带上：三种目标的 ID 各自独立编号，只按 target_id 过滤会串到别的类型上。
	  课程评论挂的是 course_id（课程级），不是 learning_course_video.video_id。
	-->
	<delete id="deleteInteractionByCourseIds" parameterType="Long">
		delete from learning_interaction where target_type = '2' and target_id in
		<foreach collection="array" item="courseId" open="(" separator="," close=")">
			#{courseId}
		</foreach>
	</delete>

	<!-- where 带 del_flag = '0'：重复执行不会反复改写已删评论的 update_time -->
	<update id="softDeleteCommentByCourseIds" parameterType="Long">
		update learning_comment set del_flag = '2', update_time = sysdate()
		 where target_type = '2' and target_id in
		<foreach collection="array" item="courseId" open="(" separator="," close=")">
			#{courseId}
		</foreach>
		and del_flag = '0'
	</update>

</mapper>
